# The AI Lion's Den configuration.
# Copy this file to .env. The Python server also reads .env.local, which overrides .env.

# Jury engine
# Demo mode returns prepared, persona-consistent responses without any network call.
# It is also forced on whenever OPENAI_API_KEY is empty.
DEMO_MODE=true

# Real model access (OpenAI or any OpenAI-compatible endpoint).
OPENAI_API_KEY=
# Optional. For Azure OpenAI use the v1-compatible endpoint, for example:
# https://your-resource.openai.azure.com/openai/v1/
OPENAI_BASE_URL=
# On Azure this is the deployment name.
OPENAI_MODEL=gpt-4.1-mini

# Optional tuning. Temperature is retried without the parameter if a model rejects it.
JURY_TEMPERATURE=0.4
JURY_TIMEOUT_MS=60000
JURY_MAX_CONCURRENCY=8
# Seconds between "every jury answer is in" and the automatic advance to the defense. 0 turns it off.
JURY_AUTO_ADVANCE_SECONDS=15
# Base delay for prepared demo responses, to rehearse realistic timing.
DEMO_DELAY_MS=2200

# Moderator view password.
MODERATOR_PASSWORD=change-me

# Used to build the join link and QR code. Set this to the reachable URL when behind a proxy.
PUBLIC_BASE_URL=http://localhost:3000

# Optional short link (for example from a URL shortener) that redirects to the join page.
# The projector shows it instead of the long join link; the QR code still points at the app.
# JOIN_SHORT_URL=https://short.example/join

# SQLite session file. The directory is created automatically.
SESSION_DB=./data/session.db
